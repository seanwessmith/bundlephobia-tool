{
  "name": "bundlephobia-tool",
  "version": "1.3.6",
  "description": "CLI to check npm package bundle size, gzip size, dependency weight, similar packages, and package.json dependencies with Bundlephobia",
  "author": "seanwessmith",
  "license": "MIT",
  "keywords": [
    "bundlephobia",
    "bundlephobia-cli",
    "package-size",
    "bundle-size",
    "gzip-size",
    "npm",
    "npm-package-size",
    "dependency-size",
    "package-json",
    "analyzer",
    "cli",
    "dependencies",
    "performance",
    "optimization",
    "frontend",
    "bundle-analyzer",
    "bun",
    "node"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanwessmith/bundlephobia-tool.git"
  },
  "bugs": {
    "url": "https://github.com/seanwessmith/bundlephobia-tool/issues"
  },
  "homepage": "https://github.com/seanwessmith/bundlephobia-tool#readme",
  "type": "module",
  "engines": {
    "node": ">=20",
    "bun": ">=1.0.0"
  },
  "bin": {
    "pkg-size": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/cli.ts --outfile ./dist/cli.js --target node",
    "start": "bun run src/cli.ts",
    "test": "bun test",
    "prepublishOnly": "bun test && bun run build"
  },
  "dependencies": {
    "ora": "^9.3.0",
    "commander": "^14.0.3",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "bun-types": "1.3.11"
  }
}
