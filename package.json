{
  "name": "bundlephobia-tool",
  "version": "1.1.2",
  "module": "src/cli.ts",
  "type": "module",
  "bin": {
    "pkg-size": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build ./src/cli.ts --outdir ./dist --target bun",
    "start": "bun run src/cli.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "ora": "^8.2.0",
    "chalk": "^5.5.0",
    "commander": "^14.0.0",
    "open": "^10.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "bun-types": "1.2.20"
  }
}
