{
  "name": "bundlephobia-tool",
  "version": "1.1.0",
  "module": "src/cli.ts",
  "type": "module",
  "bin": {
    "pkg-size": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build ./src/cli.ts --outdir ./dist --target bun",
    "start": "bun run src/cli.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "ora": "^8.2.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "bun-types": "1.2.5"
  }
}